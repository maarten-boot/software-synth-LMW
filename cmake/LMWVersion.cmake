# Spec S6.10: writes LMWVersion.h (LMW_VERSION from project(), LMW_COMMIT from git) at every build; the
# file only changes when the version or commit does. Run as: cmake -DVERSION=.. -DSOURCE_DIR=.. -DOUT=.. -P
set(commit "")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -c safe.directory=* describe --always --dirty --abbrev=7
                    WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE commit ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
endif()
if(commit STREQUAL "" AND DEFINED ENV{GITHUB_SHA})       # CI checkout without a .git directory
    string(SUBSTRING "$ENV{GITHUB_SHA}" 0 7 commit)
endif()
if(commit STREQUAL "")
    set(commit "unknown")
endif()
set(text "// Generated by cmake/LMWVersion.cmake - do not edit.\n#pragma once\n#define LMW_VERSION \"${VERSION}\"\n#define LMW_COMMIT \"${commit}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
